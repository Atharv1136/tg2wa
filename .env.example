# Shared
ENCRYPTION_KEY=
INTERNAL_API_SECRET=
LOG_LEVEL=info

# Database (Neon)
# Pooled connection string for Web serverless
DATABASE_URL=postgres://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
