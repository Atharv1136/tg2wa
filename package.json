{
  "name": "tg2wa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @tg2wa/db db:generate",
    "db:migrate": "pnpm --filter @tg2wa/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
